# EduOS AI Inference Service Configuration

# Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=info

# CORS (Configure for production)
ALLOWED_ORIGINS=*

# Model Configuration
MODEL_CACHE_DIR=/app/models

# Security Note: This service is ISOLATED from System of Record
# No database credentials should be configured here
# This service operates in ADVISORY MODE ONLY
