{
  "name": "eduos-platform",
  "version": "1.0.0",
  "description": "EduOS Platform - Multi-tenant SaaS for Educational Institutions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tenants.test.js --runInBand",
    "lint": "eslint src/**/*.js",
    "migrate": "node database/migrate.js",
    "setup": "node setup.js",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres && npm run setup"
  },
  "keywords": [
    "education",
    "saas",
    "multi-tenant"
  ],
  "author": "EduOS Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "jaeger-client": "^3.19.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "speakeasy": "^2.0.0",
    "stripe": "^20.3.1",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-logstash": "^1.2.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
