{
  "name": "eduos-platform",
  "version": "1.0.0",
  "description": "EduOS Platform - Multi-tenant SaaS for Educational Institutions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tenants.test.js --runInBand",
    "lint": "eslint src/**/*.js",
    "migrate": "node database/migrate.js",
    "setup": "node setup.js",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres && npm run setup"
  },
  "keywords": [
    "education",
    "saas",
    "multi-tenant"
  ],
  "author": "EduOS Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0"
  }
}
