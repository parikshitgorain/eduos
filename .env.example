# EduOS Platform - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduos_db
DB_USER=eduos_app
DB_PASSWORD=change_me_in_production

# PostgreSQL Superuser (for migrations only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Configuration
SESSION_TTL=3600
SESSION_MAX_CONCURRENT=5

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=development
PORT=3000

# API Configuration
API_VERSION=v1
API_BASE_URL=http://localhost:3000/api/v1

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=eduos-platform
JWT_AUDIENCE=eduos-api

# RS256 Key Pair (Optional - for production use)
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# OAuth2 Configuration - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth2 Configuration - Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Base URL for OIDC discovery
BASE_URL=http://localhost:3000

# MFA Configuration
MFA_ISSUER=EduOS Platform
MFA_WINDOW=1
MFA_ENCRYPTION_KEY=change_me_to_a_32_character_key_in_production

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ============================================================================
# MULTI-TENANT CONFIGURATION
# ============================================================================

# Tenant Quotas (Basic Tier)
BASIC_TIER_MAX_STUDENTS=1000
BASIC_TIER_MAX_STORAGE_GB=10
BASIC_TIER_MAX_API_CALLS_PER_DAY=10000

# Tenant Quotas (Business Tier)
BUSINESS_TIER_MAX_STUDENTS=5000
BUSINESS_TIER_MAX_STORAGE_GB=50
BUSINESS_TIER_MAX_API_CALLS_PER_DAY=100000

# Tenant Quotas (Enterprise Tier)
ENTERPRISE_TIER_MAX_STUDENTS=unlimited
ENTERPRISE_TIER_MAX_STORAGE_GB=unlimited
ENTERPRISE_TIER_MAX_API_CALLS_PER_DAY=unlimited

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Configuration (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Currency
DEFAULT_CURRENCY=INR

# ============================================================================
# AI SERVICE CONFIGURATION
# ============================================================================

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Model Configuration
DUPLICATE_DETECTION_THRESHOLD=0.75
SEMANTIC_SIMILARITY_THRESHOLD=0.85
RISK_SCORE_THRESHOLD=75

# AI Kill Switch
AI_ENABLED=true

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# S3-Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=eduos-media
S3_REGION=us-east-1

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eduos.com

# ============================================================================
# SMS CONFIGURATION
# ============================================================================

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# MONITORING & LOGGING
# Task: 4.4.1 - Setup monitoring and observability stack
# ============================================================================

# Service Configuration
SERVICE_NAME=eduos-api
APP_VERSION=1.0.0

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Sentry Configuration (Error Tracking)
SENTRY_DSN=

# Prometheus Metrics
METRICS_ENABLED=true

# Jaeger Distributed Tracing
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1
JAEGER_COLLECTOR_ENDPOINT=

# Logstash (ELK Stack)
LOGSTASH_ENABLED=true
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# Alertmanager
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
PAGERDUTY_SERVICE_KEY=

# ============================================================================
# RATE LIMITING & DDOS PROTECTION
# Task: 4.3.1 - Implement rate limiting and DDoS protection
# ============================================================================

# Public API Rate Limits (requests per minute per IP)
PUBLIC_RATE_LIMIT=100

# Authenticated User Rate Limits (requests per minute per user)
AUTHENTICATED_RATE_LIMIT=1000

# Authentication Rate Limits (attempts per 15 minutes)
AUTH_RATE_LIMIT=5

# Password Reset Rate Limits (requests per hour)
PASSWORD_RESET_RATE_LIMIT=3

# MFA Rate Limits (attempts per 15 minutes)
MFA_RATE_LIMIT=10

# Domain Verification Rate Limits (requests per hour)
DOMAIN_VERIFICATION_RATE_LIMIT=10

# Legacy API Rate Limit (for backward compatibility)
API_RATE_LIMIT=100

# ============================================================================
# ENCRYPTION & KEY MANAGEMENT
# Task: 4.3.3 - Implement encryption at rest and in transit
# ============================================================================

# Master Encryption Key (minimum 32 characters)
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=change_me_to_a_secure_random_32_character_key_in_production

# Key Management System Provider: 'env', 'aws', or 'vault'
KMS_PROVIDER=env

# AWS KMS Configuration (if using AWS KMS)
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1

# HashiCorp Vault Configuration (if using Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_KEY_PATH=secret/data/eduos/encryption-key

# ============================================================================
# TLS/SSL CONFIGURATION
# Task: 4.3.3 - Implement encryption at rest and in transit
# ============================================================================

# Enable TLS 1.3 for HTTPS
TLS_ENABLED=false

# TLS Certificate Paths
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=

# Client Certificate Authentication (optional)
TLS_REQUEST_CLIENT_CERT=false
TLS_REJECT_UNAUTHORIZED=true

# HTTPS Port (if TLS is enabled)
HTTPS_PORT=3443

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Features
FEATURE_AI_DUPLICATE_DETECTION=true
FEATURE_AI_RISK_PREDICTION=true
FEATURE_OFFLINE_ATTENDANCE=true
FEATURE_CUSTOM_DOMAINS=false
FEATURE_SSO=false

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@eduos.local
PGADMIN_DEFAULT_PASSWORD=admin

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# IMPORTANT: Update these values in production!
# - Change all passwords and secrets
# - Use strong random strings for JWT_SECRET
# - Configure proper SMTP/SMS credentials
# - Enable HTTPS/TLS
# - Set appropriate rate limits
# - Configure backup and monitoring
