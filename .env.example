# EduOS Platform - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduos_db
DB_USER=eduos_app
DB_PASSWORD=change_me_in_production

# PostgreSQL Superuser (for migrations only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Configuration
SESSION_TTL=3600
SESSION_MAX_CONCURRENT=5

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=development
PORT=3000

# API Configuration
API_VERSION=v1
API_BASE_URL=http://localhost:3000/api/v1

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=eduos-platform
JWT_AUDIENCE=eduos-api

# RS256 Key Pair (Optional - for production use)
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# OAuth2 Configuration - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth2 Configuration - Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Base URL for OIDC discovery
BASE_URL=http://localhost:3000

# MFA Configuration
MFA_ISSUER=EduOS Platform
MFA_WINDOW=1
MFA_ENCRYPTION_KEY=change_me_to_a_32_character_key_in_production

# ============================================================================
# MULTI-TENANT CONFIGURATION
# ============================================================================

# Tenant Quotas (Basic Tier)
BASIC_TIER_MAX_STUDENTS=1000
BASIC_TIER_MAX_STORAGE_GB=10
BASIC_TIER_MAX_API_CALLS_PER_DAY=10000

# Tenant Quotas (Business Tier)
BUSINESS_TIER_MAX_STUDENTS=5000
BUSINESS_TIER_MAX_STORAGE_GB=50
BUSINESS_TIER_MAX_API_CALLS_PER_DAY=100000

# Tenant Quotas (Enterprise Tier)
ENTERPRISE_TIER_MAX_STUDENTS=unlimited
ENTERPRISE_TIER_MAX_STORAGE_GB=unlimited
ENTERPRISE_TIER_MAX_API_CALLS_PER_DAY=unlimited

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Configuration (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Currency
DEFAULT_CURRENCY=INR

# ============================================================================
# AI SERVICE CONFIGURATION
# ============================================================================

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Model Configuration
DUPLICATE_DETECTION_THRESHOLD=0.75
SEMANTIC_SIMILARITY_THRESHOLD=0.85
RISK_SCORE_THRESHOLD=75

# AI Kill Switch
AI_ENABLED=true

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# S3-Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=eduos-media
S3_REGION=us-east-1

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eduos.com

# ============================================================================
# SMS CONFIGURATION
# ============================================================================

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Log Level
LOG_LEVEL=info

# Sentry Configuration (Error Tracking)
SENTRY_DSN=

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# RATE LIMITING
# ============================================================================

# Public API Rate Limits
PUBLIC_RATE_LIMIT_PER_MINUTE=100

# Authenticated API Rate Limits
AUTH_RATE_LIMIT_PER_MINUTE=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Features
FEATURE_AI_DUPLICATE_DETECTION=true
FEATURE_AI_RISK_PREDICTION=true
FEATURE_OFFLINE_ATTENDANCE=true
FEATURE_CUSTOM_DOMAINS=false
FEATURE_SSO=false

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@eduos.local
PGADMIN_DEFAULT_PASSWORD=admin

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# IMPORTANT: Update these values in production!
# - Change all passwords and secrets
# - Use strong random strings for JWT_SECRET
# - Configure proper SMTP/SMS credentials
# - Enable HTTPS/TLS
# - Set appropriate rate limits
# - Configure backup and monitoring
